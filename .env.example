# Copy to .env for local (non-container) runs: `cp .env.example .env`.
# Every variable is validated at startup (packages/service/src/config.ts);
# a bad value fails fast with the variable name and the fix.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# pretty | json  (json in containers, pretty for humans)
LOG_FORMAT=pretty

# Dev database (docker compose service `db`, published on the host at 5432)
DATABASE_URL=postgres://app:app@localhost:5432/app
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Log every SQL statement at debug level (set LOG_LEVEL=debug too)
LOG_SQL=false
# Queries slower than this are logged at warn with their SQL
SLOW_QUERY_MS=250
MIGRATE_ON_START=true

# Test database (compose service `db-test`, profile `test`, port 55432).
# Admin URL: the harness creates one throwaway database per test from a template.
TEST_DATABASE_ADMIN_URL=postgres://app:app@localhost:55432/postgres

# E2E target (the compose stack)
E2E_BASE_URL=http://localhost:3000
