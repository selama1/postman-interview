# Copy to .env for local (non-container) runs: `cp .env.example .env`.
# Every variable is validated at startup (packages/service/src/config.ts);
# a bad value fails fast with the variable name and the fix.

NODE_ENV=development
HOST=0.0.0.0
# Port for `pnpm dev` (the service run on the host). The container is published on API_PORT.
PORT=3000
LOG_LEVEL=info
# pretty | json  (json in containers, pretty for humans)
LOG_FORMAT=pretty

# Dev database (docker compose service `db`, published on the host at 15432 — non-standard on
# purpose, so a locally installed Postgres on 5432/5433 never clashes; override with DB_PORT)
DATABASE_URL=postgres://app:app@localhost:15432/app
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Log every SQL statement at debug level (set LOG_LEVEL=debug too)
LOG_SQL=false
# Queries slower than this are logged at warn with their SQL
SLOW_QUERY_MS=250
MIGRATE_ON_START=true
# API test mode: x-test-session header -> isolated, fresh DB per session (POST /_test/sessions).
# Never enable where real data lives.
TEST_SESSIONS_ENABLED=true
TEST_SESSION_TTL_MIN=60
TEST_SESSIONS_MAX=100

# Test database (compose service `db-test`, profile `test`, port 55432).
# Admin URL: the harness creates one throwaway database per test from a template.
TEST_DATABASE_ADMIN_URL=postgres://app:app@localhost:55432/postgres

# E2E target (the compose stack)
E2E_BASE_URL=http://localhost:3480

# Host ports of the compose stack (defaults shown; change if taken, and update the URLs above):
# API_PORT=3480
# DB_PORT=15432
# TEST_DB_PORT=55432

# --- Running a second clone side by side ---
# docker compose reads this file too. Give the copy its own project name and host ports, and point
# the URLs above at those ports:
# COMPOSE_PROJECT_NAME=planet-express-2
# API_PORT=3100
# DB_PORT=5442
# TEST_DB_PORT=55442
