#!/bin/sh
# Invariant: practice work stays LOCAL. The GitHub repo is the public interview submission
# (main only). Blocks pushing any practice branch, and any commit whose tree contains practice/,
# whatever the remote ref is called (e.g. `git push origin practice:main`, `git push --all`).
# Deliberate exception: the user runs `git push --no-verify` themselves.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote ref
  case "$local_ref $remote_ref" in
    *refs/heads/practice*)
      echo "pre-push: BLOCKED. $local_ref -> $remote_ref is a practice branch." >&2
      status=1
      continue
      ;;
  esac
  if git ls-tree -d --name-only "$local_sha" practice 2>/dev/null | grep -q '^practice$'; then
    echo "pre-push: BLOCKED. $local_ref -> $remote_ref contains practice/ files." >&2
    status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "Reason: practice sessions stay local; the remote is the public interview submission (main only)." >&2
  echo "Fix: push only main (git push origin main). If you really mean to publish practice work, run git push --no-verify yourself." >&2
fi
exit $status
