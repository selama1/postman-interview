{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-brief.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm preflight*)",
      "Bash(pnpm warm*)",
      "Bash(pnpm docs:check*)",
      "Bash(pnpm data:*)",
      "Bash(pnpm gen:resource*)",
      "Bash(pnpm migrate*)",
      "Bash(pnpm stack:up*)",
      "Bash(pnpm db:test:up*)",
      "Bash(pnpm dc ps*)",
      "Bash(pnpm dc logs*)",
      "Bash(pnpm build*)",
      "Bash(pnpm probe:*)",
      "Bash(node scripts/dc.mjs ps*)",
      "Bash(node scripts/dc.mjs logs*)",
      "Bash(node scripts/dc.mjs up*)",
      "Bash(node scripts/verify.mjs*)",
      "Bash(node scripts/preflight.mjs*)",
      "Bash(node scripts/warm.mjs*)",
      "Bash(node scripts/e2e.mjs*)",
      "Bash(node scripts/e2e-journey.mjs*)",
      "Bash(node scripts/select-tests.mjs*)",
      "Bash(node scripts/test-report.mjs*)",
      "Bash(node scripts/session-brief.mjs*)",
      "Bash(npx vitest run*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(sh scripts/smoke.sh*)",
      "Bash(wsl -e sh scripts/smoke.sh*)",
      "Bash(curl -s *)",
      "Bash(curl -i *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm typecheck*)",
      "PowerShell(pnpm verify*)",
      "PowerShell(pnpm preflight*)",
      "PowerShell(pnpm docs:check*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(pnpm dc down*)",
      "Bash(node scripts/dc.mjs down*)",
      "Bash(pnpm db:reset*)"
    ]
  }
}
